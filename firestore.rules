rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    
    // Admin check: verify verified email matching designated admin, custom claim 'admin', or admin doc
    function isAdmin() { 
      return isSignedIn() && isEmailVerified() && (
        request.auth.token.email in ['houseofkarvi.dw@gmail.com'] || 
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection: Managed strictly by authorized admins
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt']) && data.keys().size() == 2 &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt == request.time;
    }
    
    match /admins/{userId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin() && isValidAdmin(incoming());
      allow update: if false; // immutable admin record
      allow delete: if isAdmin();
    }

    // Categories Validation & Rules
    function isValidCategory(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.order is number &&
             data.visible is bool;
    }

    match /categories/{categoryId} {
      allow read: if true; // Public visitors can view categories
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Product Validation & Rules
    function isValidProduct(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             (!('price' in data) || (data.price is string && data.price.size() <= 50)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             data.image is string && data.image.size() <= 1000;
    }

    match /products/{productId} {
      allow read: if true; // Public visitors can view products
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }
    
    // Inquiries (Reach Us form submissions)
    function isValidInquiryCreate(data) {
      return data.keys().hasAll(['customerName', 'customerEmail', 'message', 'status', 'createdAt', 'updatedAt']) && 
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 150 &&
             data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 150 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 3000 &&
             data.status == 'new' &&
             data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidInquiryUpdate(data) {
      return data.status in ['new', 'read', 'replied', 'archived'] &&
             data.updatedAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isAdmin(); // Strictly admin only!
      allow list: if isAdmin(); // Strictly admin only!
      allow create: if isValidId(inquiryId) && isValidInquiryCreate(incoming()); // Public submission
      allow update: if isValidId(inquiryId) && isAdmin() && isValidInquiryUpdate(incoming());
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    // Catalog Requests form submissions
    function isValidCatalogRequestCreate(data) {
      return data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.status in ['new', 'downloaded', 'contacted'] &&
             data.createdAt == request.time;
    }

    function isValidCatalogRequestUpdate(data) {
      return data.status in ['new', 'downloaded', 'contacted'];
    }

    match /catalog_requests/{requestId} {
      allow get: if isValidId(requestId) && isAdmin(); // Strictly admin only!
      allow list: if isAdmin(); // Strictly admin only!
      allow create: if isValidId(requestId) && isValidCatalogRequestCreate(incoming()); // Public submission
      allow update: if isValidId(requestId) && isAdmin() && isValidCatalogRequestUpdate(incoming());
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // Site Settings (e.g. current Catalogue PDF information)
    match /site_settings/{settingId} {
      allow read: if true; // Public visitors can view current catalogue download info
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }
  }
}

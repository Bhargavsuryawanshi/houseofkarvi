{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Represents an administrator user",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin was created"
        }
      },
      "required": ["email", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "A collection category for products",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "order": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["name", "order", "visible", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A furniture product in the collections & catalog",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "price": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "image": {
          "type": "string",
          "maxLength": 1000
        },
        "images": {
          "type": "array"
        },
        "material": {
          "type": "string",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 3000
        },
        "size": {
          "type": "string",
          "maxLength": 300
        },
        "details": {
          "type": "string",
          "maxLength": 1500
        },
        "colors": {
          "type": "array"
        },
        "order": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        },
        "inStock": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["name", "image", "description", "size", "details", "createdAt", "updatedAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A customer inquiry from the Reach Us contact form",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "customerEmail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "enum": ["new", "read", "replied", "archived"]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["customerName", "customerEmail", "message", "status", "createdAt", "updatedAt"]
    },
    "CatalogRequest": {
      "title": "CatalogRequest",
      "description": "A customer submission requesting the Exclusive Catalogue",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "company": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["new", "downloaded", "contacted"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["fullName", "email", "status", "createdAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website settings such as current catalogue PDF",
      "type": "object",
      "properties": {
        "pdfUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "pdfName": {
          "type": "string",
          "maxLength": 255
        },
        "fileSize": {
          "type": "string",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["pdfUrl", "updatedAt"]
    }
  },
  "firestore": {
    "admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Stores admin user accounts"
    },
    "categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Stores collections categories"
    },
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stores dynamic collection and catalog products"
    },
    "inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Stores customer inquiries from Reach Us"
    },
    "catalog_requests/{requestId}": {
      "schema": { "$ref": "#/entities/CatalogRequest" },
      "description": "Stores requests for the exclusive catalogue"
    },
    "site_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Stores site configurations such as catalogue PDF details"
    }
  }
}
